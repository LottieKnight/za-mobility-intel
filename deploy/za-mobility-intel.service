# /etc/systemd/system/za-mobility-intel.service
# Bare-metal/systemd deploy of the dashboard (no Docker required).
[Unit]
Description=ZA Mobility Intelligence dashboard
After=network.target

[Service]
Type=simple
# Run as a non-privileged service account. Create with:
#   useradd -r -m -s /usr/sbin/nologin zamobility
User=zamobility
Group=zamobility
WorkingDirectory=/srv/za-mobility-intel
Environment=PORT=4173
# Point at the GR Yaris simulator checkout to enable the Simulation Runner:
# Environment=GR_YARIS_SIM=/home/user/gr_yaris_sim
# Environment=GR_YARIS_SIM_PY=/home/user/gr_yaris_sim/venv/bin/python
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target